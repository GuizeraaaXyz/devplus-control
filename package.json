{
  "name": "devplus-control",
  "version": "2.10.4",
  "description": "Dev+ Control — cliente Minecraft personalizado por Dogcode_, baseado no SoulFire.",
  "author": "Pistonmaster",
  "desktopName": "devplus-control.desktop",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "@bufbuild/buf",
    "electron",
    "electron-winstaller",
    "esbuild",
    "msw",
    "protobufjs"
  ],
  "scripts": {
    "generate-routes": "tsr generate",
    "watch-routes": "tsr watch",
    "dev": "bun run source:package && cross-env SF_ELECTRON=1 vite",
    "dev:web": "bun run source:package && vite",
    "build": "bun run source:package && vite build",
    "build:web": "bun run source:package && vite build",
    "build:electron": "bun run source:package && cross-env SF_ELECTRON=1 vite build && electron-builder --publish never",
    "build:electron:dir": "bun run source:package && cross-env SF_ELECTRON=1 vite build && electron-builder --dir --publish never",
    "build:electron:flatpak": "bun run source:package && cross-env SF_ELECTRON=1 vite build && electron-builder --linux flatpak --publish never -c.extraMetadata.desktopName=com.dogcode.devplus.desktop",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "fix": "oxlint --fix . && oxfmt .",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run lint && bun run format:check",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "protocol:generate": "buf generate",
    "branding:generate": "node scripts/generate-branding.mjs",
    "branding:check": "node scripts/check-branding.mjs",
    "build:windows": "bun run branding:generate && bun run source:package && cross-env SF_ELECTRON=1 vite build && electron-builder --win nsis --x64 --publish never",
    "source:package": "node scripts/package-source.mjs",
    "license:server": "bun run license-server/server.mjs",
    "license:admin": "bun run scripts/license-admin.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:functions": "supabase functions serve",
    "branding:test": "node scripts/check-branding-generation.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@bufbuild/protobuf": "2.14.0",
    "@catppuccin/palette": "^1.8.0",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-web": "^2.1.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "2.112.3",
    "@tanstack/match-sorter-utils": "^9.0.0",
    "@tanstack/query-broadcast-client-experimental": "^5.99.0",
    "@tanstack/react-form": "^1.29.0",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-query-devtools": "5.103.1",
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/router-devtools": "^1.166.13",
    "@tanstack/store": "^0.11.1",
    "@xhayper/discord-rpc": "^1.3.4",
    "@xyflow/react": "^12.10.2",
    "adm-zip": "^0.6.0",
    "bonjour-service": "^1.3.0",
    "castv2-client": "^1.2.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "country-flag-icons": "^1.6.16",
    "date-fns": "^4.1.0",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.6.2",
    "embla-carousel-react": "^8.6.0",
    "fancy-ansi": "^0.1.3",
    "file-saver": "^2.0.5",
    "i18next": "^26.0.5",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-resources-to-backend": "^1.2.1",
    "input-otp": "^1.4.2",
    "js-sha256": "^1.0.0",
    "mime-matcher": "^1.0.5",
    "motion": "^13.0.0",
    "nanoid": "^6.0.0",
    "next-themes": "^0.4.6",
    "node-addon-api": "^8.7.0",
    "nuqs": "2.10.1",
    "posthog-js": "^1.433.4",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-day-picker": "10.0.2",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.4",
    "react-number-format": "^5.4.5",
    "react-resizable-panels": "^4.10.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tar": "^7.5.13",
    "tw-animate-css": "^1.4.0",
    "urijs": "^1.19.11",
    "use-stick-to-bottom": "^1.1.3",
    "webdav": "^5.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@bufbuild/buf": "1.72.0",
    "@bufbuild/protoc-gen-es": "2.14.0",
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/devtools-vite": "^0.8.0",
    "@tanstack/react-devtools": "^0.10.2",
    "@tanstack/react-form-devtools": "^0.2.21",
    "@tanstack/react-router": "^1.168.22",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/router-cli": "^1.166.33",
    "@tanstack/router-plugin": "^1.167.22",
    "@types/babel__core": "^7.20.5",
    "@types/file-saver": "^2.0.7",
    "@types/loadable__component": "^5.13.10",
    "@types/node": "^26.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/urijs": "^1.19.26",
    "@vitejs/plugin-react": "^6.0.1",
    "app-builder-bin": "5.0.0-alpha.13",
    "autoprefixer": "^10.5.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "lucide-react": "^1.8.0",
    "lucide-static": "^1.8.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "postcss": "^8.5.10",
    "react-hooks": "^1.0.1",
    "shadcn": "^4.3.0",
    "sharp": "^0.35.5",
    "supabase": "2.121.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^7.0.0",
    "vite": "^8.0.8",
    "vite-plugin-electron": "^1.0.0",
    "vite-plugin-svgr": "^5.2.0",
    "yaml": "^2.8.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,css,md,mdx,yml,yaml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "build": {
    "appId": "com.dogcode.devplus",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "electronUpdaterCompatibility": ">=2.16",
    "directories": {
      "output": "release-artifacts"
    },
    "files": [
      "build/icons/**",
      "dist/**",
      "dist-electron/**",
      "locales/**",
      "public/**",
      "package.json",
      "soulfire-server-version.txt",
      "LICENSE",
      "branding/README.md",
      "DEVPLUS.md"
    ],
    "publish": null,
    "linux": {
      "category": "Development",
      "description": "Dev+ Control — cliente Minecraft personalizado por Dogcode_, baseado no SoulFire.",
      "desktop": {
        "entry": {
          "StartupWMClass": "devplus-control",
          "X-GNOME-WMClass": "devplus-control"
        }
      },
      "executableName": "devplus-control",
      "icon": "build/icons/icon.png",
      "maintainer": "Dogcode_",
      "synopsis": "Dev+ Control",
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman"
      ],
      "vendor": "Dogcode_"
    },
    "appImage": {
      "license": "LICENSE"
    },
    "deb": {
      "packageCategory": "devel",
      "priority": "optional"
    },
    "rpm": {
      "packageCategory": "Development/Tools"
    },
    "pacman": {
      "compression": "xz"
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "25.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "25.08",
      "branch": "stable",
      "license": "LICENSE",
      "files": [
        [
          "com.soulfiremc.soulfire.metainfo.xml",
          "/share/metainfo/com.soulfiremc.soulfire.metainfo.xml"
        ]
      ],
      "finishArgs": [
        "--share=ipc",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=pulseaudio",
        "--share=network",
        "--filesystem=home",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=com.canonical.Unity",
        "--env=ELECTRON_TRASH=gio",
        "--env=XCURSOR_PATH=/run/host/user-share/icons:/run/host/share/icons"
      ],
      "useWaylandFlags": true
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "icon": "build/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "DevPlus-Control-Setup.exe",
      "shortcutName": "Dev+ Control",
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico"
    },
    "productName": "Dev+ Control",
    "protocols": [
      {
        "name": "SoulFire",
        "schemes": [
          "soulfire"
        ]
      }
    ],
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "Dev+ Control"
    }
  },
  "overrides": {
    "node-abi": "^4.35.0"
  }
}
