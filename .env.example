VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=<ph_project_token>
VITE_PUBLIC_POSTHOG_HOST=https://tc.soulfiremc.com

# License API mode: "bun" for the local license-server, "supabase" for Edge Functions.
VITE_LICENSE_API_MODE=bun
VITE_LICENSE_API_URL=http://127.0.0.1:8787

# Public Supabase settings used by the license client and admin panel.
# Publishable keys are public by design; never place a secret/service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
